// For format details, see https://aka.ms/devcontainer.json
// Largely taken from https://github.com/raphaelschwinger/cuda-python-devcontainer/
{
    "name": "master-thesis-lmertens",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            // Choose valid combination from https://hub.docker.com/r/nvidia/cuda/tags
            "VARIANT": "ubuntu22.04",
            "CUDA_VERSION": "12.4.1",
            "USERNAME": "${localEnv:USER}",
            // Automatically maps host UID/GID into the container to avoid permission conflicts
            "USER_UID": "${localEnv:UID:1000}",
            "USER_GID": "${localEnv:GID:1000}"
        }
    },
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
        // Docker CLI — lets the devcontainer talk to the host daemon (DooD).
        // Spawns sibling containers; no Docker-in-Docker, no --privileged needed.
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    // Enable full NVIDIA GPU forwarding
    "runArgs": [
        "--gpus",
        "all",
        "--shm-size=32gb",
        "--dns=134.245.10.7",
        "--dns=134.245.1.2",
        "--dns=134.245.1.36",
        "--dns-search=ins.informatik.uni-kiel.de",
        "--dns-search=informatik.uni-kiel.de"
    ],
    "mounts": [
        // SSH agent socket — forwards the agent from local machine via SSH ForwardAgent.
        // Requires a stable symlink on the server: ln -sf $SSH_AUTH_SOCK ~/.ssh/ssh_auth_sock
        // (add to ~/.bashrc on the remote server)
        "source=${localEnv:HOME}/.ssh/ssh_auth_sock,target=/ssh-agent,type=bind",
        // TODO: Remove this
        "source=${localEnv:HOME}/git-repos,target=/home/${localEnv:USER}/git-repos,type=bind,consistency=cached",
        // Data home — read/write
        "source=/datahome/lmertens,target=/datahome/lmertens,type=bind",
        // Local data mount
        "source=/datalocal/lmertens,target=/datalocal/lmertens,type=bind,consistency=cached",
        // Shadow the host .venv with a container-local Docker volume — prevents
        // Python interpreter mismatches between the host and container environments.
        "source=master-thesis-lmertens-venv,target=/workspaces/master-thesis-lmertens/.venv,type=volume",
        // Auth tokens
        "source=${localEnv:HOME}/.kleinkram.json,target=/home/${localEnv:USER}/.kleinkram.json,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.claude,target=/home/${localEnv:USER}/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.claude.json,target=/home/${localEnv:USER}/.claude.json,type=bind,consistency=cached",
        // Persist fish history across rebuilds (uv cache intentionally not persisted)
        "source=master-thesis-lmertens-fish-history,target=/home/${localEnv:USER}/.local/share/fish,type=volume",
        // Docker socket — required for DooD (spawning sibling containers)
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    ],
    "remoteEnv": {
        "SSH_AUTH_SOCK": "/ssh-agent"
    },
    "containerEnv": {
        "WANDB_API_KEY": "${localEnv:WANDB_API_KEY}",
        "HF_TOKEN": "${localEnv:HF_TOKEN}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "astral-sh.ty",
                "charliermarsh.ruff",
                "percy.vscode-numpy-viewer",
                "tamasfe.even-better-toml",
                "anthropic.claude-code",
            ],
            "settings": {
                // Use fish as the default integrated terminal shell
                "terminal.integrated.defaultProfile.linux": "fish",
                "terminal.integrated.profiles.linux": {
                    "fish": {
                        "path": "/usr/bin/fish"
                    }
                },
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
            }
        }
    },
    // Run as the mapped host user
    "remoteUser": "${localEnv:USER}",
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // "forwardPorts": [],
    // Post-create: sync dependencies and register the venv as a Jupyter kernel
    "postCreateCommand": "sudo chown -R ${localEnv:USER}:${localEnv:USER} /workspaces/master-thesis-lmertens/.venv /home/${localEnv:USER}/.local && uv sync && python3 -m ipykernel install --user --name python3 --display-name 'Python 3 (container)'"
}